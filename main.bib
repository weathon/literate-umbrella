@article{cretu_interaction_2022,
  title = {Interaction Data Are Identifiable Even across Long Periods of Time},
  author = {Cre{\c t}u, Ana-Maria and Monti, Federico and Marrone, Stefano and Dong, Xiaowen and Bronstein, Michael and {de Montjoye}, Yves-Alexandre},
  year = 2022,
  month = jan,
  journal = {Nature Communications},
  volume = {13},
  pages = {313},
  issn = {2041-1723},
  doi = {10.1038/s41467-021-27714-6},
  urldate = {2026-01-01},
  abstract = {Fine-grained records of people's interactions, both offline and online, are collected at large scale. These data contain sensitive information about whom we meet, talk to, and when. We demonstrate here how people's interaction behavior is stable over long periods of time and can be used to identify individuals in anonymous datasets. Our attack learns the profile of an individual using geometric deep learning and triplet loss optimization. In a mobile phone metadata dataset of more than 40k people, it correctly identifies 52\% of individuals based on their 2-hop interaction graph. We further show that the profiles learned by our method are stable over time and that 24\% of people are still identifiable after 20 weeks. Our results suggest that people with well-balanced interaction graphs are more identifiable. Applying our attack to Bluetooth close-proximity networks, we show that even 1-hop interaction graphs are enough to identify people more than 26\% of the time. Our results provide strong evidence that disconnected and even re-pseudonymized interaction data can be linked together making them personal data under the European Union's General Data Protection Regulation., Large amounts of interaction data are collected by messaging apps, mobile phone carriers, and social media. Cre\c tu et al. propose a behavioral profiling attack model and show that~the stability of people's interaction networks over time can allow individuals to be re-identified in interaction datasets.},
  pmcid = {PMC8789822},
  pmid = {35078995},
  file = {/Users/wenqiguo/Zotero/storage/8IGGCWZ2/Creţu et al. - 2022 - Interaction data are identifiable even across long periods of time.pdf}
}

