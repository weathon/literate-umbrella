}

@misc{chen_mvibench_2025,
  title = {{{MVI-Bench}}: {{A Comprehensive Benchmark}} for {{Evaluating Robustness}} to {{Misleading Visual Inputs}} in {{LVLMs}}},
  shorttitle = {{{MVI-Bench}}},
  author = {Chen, Huiyi and Peng, Jiawei and Min, Dehai and Sun, Changchang and Chen, Kaijie and Yan, Yan and Yang, Xu and Cheng, Lu},
  year = 2025,
