  abstract = {Safety alignment in Large Language Models is critical for healthcare; however, reliance on binary refusal boundaries often results in \textbackslash emph\textbraceleft over-refusal\textbraceright{} of benign queries or \textbackslash emph\textbraceleft unsafe compliance\textbraceright{} with harmful ones. While existing benchmarks measure these extremes, they fail to evaluate Safe Completion: the model's ability to maximise helpfulness on dual-use or borderline queries by providing safe, high-level guidance without crossing into actionable harm. We introduce \textbackslash textbf\textbraceleft Health-ORSC-Bench\textbraceright, the first large-scale benchmark designed to systematically measure \textbackslash textbf\textbraceleft Over-Refusal\textbraceright{} and \textbackslash textbf\textbraceleft Safe Completion\textbraceright{} quality in healthcare. Comprising 31,920 benign boundary prompts across seven health categories (e.g., self-harm, medical misinformation), our framework uses an automated pipeline with human validation to test models at varying levels of intent ambiguity. We evaluate 30 state-of-the-art LLMs, including GPT-5 and Claude-4, revealing a significant tension: safety-optimised models frequently refuse up to 80\textbackslash\% of "Hard" benign prompts, while domain-specific models often sacrifice safety for utility. Our findings demonstrate that model family and size significantly influence calibration: larger frontier models (e.g., GPT-5, Llama-4) exhibit "safety-pessimism" and higher over-refusal than smaller or MoE-based counterparts (e.g., Qwen-3-Next), highlighting that current LLMs struggle to balance refusal and compliance. Health-ORSC-Bench provides a rigorous standard for calibrating the next generation of medical AI assistants toward nuanced, safe, and helpful completions. The code and data will be released upon acceptance. \textbackslash textcolor\textbraceleft red\textbraceright\textbraceleft Warning: Some contents may include toxic or undesired contents.\textbraceright},
  archiveprefix = {arXiv},
  keywords = {Computer Science - Artificial Intelligence},
  file = {/Users/wenqiguo/Zotero/storage/BEW45JAV/Zhang et al. - 2026 - Health-ORSC-Bench A Benchmark for Measuring Over-Refusal and Safety Completion in Health Context.pdf}
}

