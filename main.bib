  number = {arXiv:2602.02914},
  eprint = {2602.02914},
  primaryclass = {cs},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2602.02914},
  urldate = {2026-02-21},
  abstract = {Transformation-based privacy-preserving face recognition (PPFR) aims to verify identities while hiding facial data from attackers and malicious service providers. Existing evaluations mostly treat privacy as resistance to pixel-level reconstruction, measured by PSNR and SSIM. We show that this reconstruction-centric view fails. We present FaceLinkGen, an identity extraction attack that performs linkage/matching and face regeneration directly from protected templates without recovering original pixels. On three recent PPFR systems, FaceLinkGen reaches over 98.5\textbackslash\% matching accuracy and above 96\textbackslash\% regeneration success, and still exceeds 92\textbackslash\% matching and 94\textbackslash\% regeneration in a near zero knowledge setting. These results expose a structural gap between pixel distortion metrics, which are widely used in PPFR evaluation, and real privacy. We show that visual obfuscation leaves identity information broadly exposed to both external intruders and untrusted service providers.},
  archiveprefix = {arXiv},
  keywords = {Computer Science - Computer Vision and Pattern Recognition},
  file = {/Users/wenqiguo/Zotero/storage/6CIZXXGS/Guo and Du - 2026 - FaceLinkGen Rethinking Identity Leakage in Privacy-Preserving Face Recognition with Identity Extrac.pdf}
}

